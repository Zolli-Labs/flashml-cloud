# monorepo: the three product trees live here as subtrees, not ignored.
# `git subtree split --prefix=<dir>` detaches any of them with history intact.
# local state and venvs
e2e/.venv/
.local-state/
__pycache__/
.pytest_cache/
.DS_Store

# Secrets. `.env` holds the real deploy values; `.env.example` is the
# committed, value-free template. audit_secrets.sh asserts .env is untracked,
# but that check passes trivially while no .env exists — this ignore rule is
# the actual guard, and it must come before anyone creates the file.
.env
.env.*
!.env.example
# ...and the DEV template. `.env.*` above swallows this too, so it needs its
# own negation or the file silently never gets committed — which is how a
# template that only exists on one laptop happens.
!.env.dev.example
.env.alibaba
**/.venv/
**/node_modules/
**/.next/
**/.superpowers/
.worktrees/

# Build artifacts and local databases. flashml-cloud.db and
# apps/api/*.egg-info were tracked by accident; egg-info in particular goes
# stale the moment anyone reinstalls and then produces diffs that look like
# real changes. Nothing here is an input to a build.
*.db
*.egg-info/
build/
dist/
.gstack/
**/.artifacts/

# smoke-test / competition evidence bundles (sandbox ids, account state)
.evidence/
