# Alibaba Cloud deployment profile — copy to .env.alibaba and fill in.
# NEVER commit .env.alibaba. All values are deployment configuration; none of
# them belong in the public FlashRuntime JobSpec.

# Region and cluster
ALIBABA_REGION=ap-southeast-1
ACK_CLUSTER_NAME=flashml-poc

# ACR (Container Registry). Registry endpoint WITHOUT protocol.
ACR_REGISTRY=registry-intl.ap-southeast-1.aliyuncs.com
ACR_NAMESPACE=flashml
# Credentials for `docker login` — a RAM user with AliyunContainerRegistry
# push permission. Password read from ACR_PASSWORD at runtime, never echoed.
ACR_USERNAME=
ACR_PASSWORD=

# OSS (artifact store)
OSS_BUCKET=flashml-artifacts
OSS_ENDPOINT=oss-ap-southeast-1-internal.aliyuncs.com
# RAM user/STS credentials with least privilege on the bucket only.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS token when using assumed roles
OSS_SECURITY_TOKEN=

# SLS (Simple Log Service)
SLS_PROJECT=flashml-poc
SLS_LOGSTORE=flashml-jobs

# Sandboxed-container secure pool (leave empty if the cluster has none).
# RuntimeClass name comes from the ACK sandboxed-container installation.
FLASHML_RUNTIME_CLASS=
FLASHML_STANDARD_NODE_SELECTOR=flashml.dev/pool=standard-cloud
FLASHML_SANDBOX_NODE_SELECTOR=
