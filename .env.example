# FlashML Cloud — template for the PRODUCTION environment. Copy to
# `.env.prod` and fill in. It is gitignored; this file must never contain a
# real value.
#
# Renamed from `.env` on 2026-08-02. There used to be a single `.env` holding
# production values, which `scripts/dev.sh` sourced by default — so local
# development read and wrote the rows the deployed console serves. The two
# environments now have names that say which is which, and dev.sh refuses to
# start against the production project ref without `--i-mean-production`.
#
# For local work you almost certainly want `.env.dev.example` instead.
#
# On Render these are supplied by the Blueprint's `sync: false` prompts, not
# by this file. It exists so the required set is discoverable from the repo
# and so a new environment can be stood up without reverse-engineering
# settings.py.
#
# `.env.dev.example` carries the map of WHICH OF THE THREE PLACES each value
# has to exist in — this repo root, the tracked templates, and the Render
# dashboard — and why the first and last drifting apart is the failure nothing
# detects. Read it once; it is not repeated here.

# --- flashml-api -----------------------------------------------------------

# REQUIRED. Project URL; the JWKS endpoint used to verify browser tokens is
# derived from it.
SUPABASE_URL=https://<project-ref>.supabase.co

# OPTIONAL, legacy. Leave empty for any project signing ES256 (all current
# ones). Set only during a rotation away from a previous HS256 key.
SUPABASE_JWT_SECRET=

# REQUIRED for anything DB-backed.
#
# Keep the password in its OWN variable and let the URL be composed from it.
# scripts/dev.sh sources this file with `set -a; source .env`, which is bash,
# so ${DATABASE_PASSWORD} expands. Rotating then means editing one short
# field instead of surgery on a 100-character URL — and every outage this
# setting has caused came from hand-editing that URL and getting one piece
# wrong.
#
# Use LETTERS AND DIGITS ONLY for the password. Anything containing
# @ # / : ? & must be percent-encoded (%40 %23 %2F %3A %3F %26) or the URI
# parses wrong — and it fails in a way that names a database, not a password.
DATABASE_PASSWORD=

# Do not edit — assembled from the password above.
#
# SESSION pooler, port 5432. NOT the direct connection (IPv6-only on current
# projects; Render may not route to it) and NOT the transaction pooler on
# :6543 (breaks psycopg's prepared statements intermittently).
#
# The `postgres.<ref>` username is load-bearing: the pooler reads the suffix
# to find your tenant. Omit it and the error is
# `FATAL: database "postgres" does not exist`, which points at the wrong
# thing entirely and cost a day on 2026-08-01.
DATABASE_URL=postgresql://postgres.<ref>:${DATABASE_PASSWORD}@aws-0-<region>.pooler.supabase.com:5432/postgres

# NOTE: there is deliberately no SUPABASE_SERVICE_KEY here. Nothing reads it
# and it bypasses every RLS policy — see M1_DECISIONS.md D15. If you add a
# Supabase Storage or Admin-API caller, add the key to this file, to
# render.yaml, and to the required list in settings.from_env together.

# Wired automatically by render.yaml `fromService`; set by hand only for a
# local run against a local coordinator.
# COORDINATOR_URL=http://localhost:8080
# COORDINATOR_OPERATOR_TOKEN=

# OPTIONAL. Mail. The API sends two product emails — access approved and
# access declined — through Resend. Absent, it boots and serves and sends
# nothing; these are deliberately NOT in the required list. A new key goes
# into this template, render.yaml, AND settings.from_env together (same rule
# as SUPABASE_SERVICE_KEY above).
#
# WHERE THIS COMES FROM, if the keys are ever lost and have to be rebuilt
# from nothing:
#
#   Resend -> Domains    the sending domain must be VERIFIED before anything
#                        sends. Add the DKIM/SPF records it prints to the DNS
#                        zone. An unverified domain is refused at send time,
#                        which reads as a bad key rather than a missing
#                        domain — check this first when a send fails.
#   Resend -> API Keys   Create, permission "Sending access" only. Nothing in
#                        this codebase reads or administers anything at
#                        Resend, so a Full-access key grants reach nothing
#                        needs.
#
# The key is shown EXACTLY ONCE, at creation. Resend cannot display an
# existing key again, so a lost key is REPLACED, never recovered: create a
# new one and update both API services in Render.
RESEND_API_KEY=

# OPTIONAL. e.g. "FlashML <no-reply@zolliai.com>". The domain here must be
# the one VERIFIED in Resend — a subdomain of a verified domain does NOT
# inherit verification, and Resend answers 403 "domain is not verified"
# rather than anything naming this variable. Mail sends only when
# this AND RESEND_API_KEY are both set.
#
# KEEP THE QUOTES. dev.sh reads this file with `set -a; source`, so every
# line is executed as shell: an unquoted < is an input redirect, and dev.sh
# dies before it starts anything with an error naming neither this file nor
# this line. The display-name form is the only value here that contains one.
EMAIL_FROM=

# OPTIONAL, falls back to EMAIL_FROM. MUST be a mailbox that actually
# RECEIVES mail — a Resend-verified sending subdomain like
# a verified sending domain has no MX record of its own, so DKIM/SPF setup
# alone does not make this address real. Resolve it before RESEND_API_KEY is
# set anywhere; see render.yaml.
EMAIL_REPLY_TO=

# --- flashml-web (these reach the browser; publishable values only) --------
#
# Both of the SUPABASE_* pairs below hold the SAME value as their non-prefixed
# twin above. That is not redundancy to tidy away: the unprefixed one is read
# by the API process, the NEXT_PUBLIC_ one is compiled into the JavaScript
# bundle. Different consumers, one project.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Must MATCH the value set on flashml-web in the Render dashboard — that one
# is `sync: false`, so it lives outside git and nothing compares them. When
# these disagree, Supabase answers every sign-in with "Unregistered API key"
# and the console looks broken while the API is fine. It happened on the dev
# pair on 2026-08-04. After any key rotation, update both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>

# Which API the console talks to. The name matters: `cloudApiBase()` reads
# NEXT_PUBLIC_CLOUD_API and nothing else.
#
# render.yaml sets this as an EXPLICIT LITERAL, deliberately — NOT
# `fromService: {property: host}`. NEXT_PUBLIC_* is inlined by Next.js at
# BUILD time, and a fromService reference that does not resolve during the
# build yields an empty string: the site serves, sign-in works (Supabase has
# its own vars), and every API call fails with "Failed to fetch". See the
# comment on flashml-web in render.yaml.
#
# scripts/dev.sh exports this file, so this value is what `npm run dev`
# inlines into the bundle. There is no apps/web/.env.local any more — it was
# a duplicate copy of the NEXT_PUBLIC_* trio and was removed on 2026-08-04.
NEXT_PUBLIC_CLOUD_API=https://flashml-api.onrender.com
