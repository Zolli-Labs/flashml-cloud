# FlashML Cloud — template for the deploy environment. Copy to `.env` and
# fill in. `.env` is gitignored; this file must never contain a real value.
#
# On Render these are supplied by the Blueprint's `sync: false` prompts, not
# by this file. It exists so the required set is discoverable from the repo
# and so a new environment can be stood up without reverse-engineering
# settings.py.

# --- flashml-api -----------------------------------------------------------

# REQUIRED. Project URL; the JWKS endpoint used to verify browser tokens is
# derived from it.
SUPABASE_URL=https://<project-ref>.supabase.co

# OPTIONAL, legacy. Leave empty for any project signing ES256 (all current
# ones). Set only during a rotation away from a previous HS256 key.
SUPABASE_JWT_SECRET=

# REQUIRED for anything DB-backed. Use Supabase's SESSION pooler:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# NOT the direct connection (IPv6-only; Render may not route it) and NOT the
# transaction pooler on :6543 (breaks psycopg's prepared statements).
# Percent-encode @ # / : ? & in the password (%40 %23 %2F %3A %3F %26).
DATABASE_URL=

# NOTE: there is deliberately no SUPABASE_SERVICE_KEY here. Nothing reads it
# and it bypasses every RLS policy — see M1_DECISIONS.md D15. If you add a
# Supabase Storage or Admin-API caller, add the key to this file, to
# render.yaml, and to the required list in settings.from_env together.

# Wired automatically by render.yaml `fromService`; set by hand only for a
# local run against a local coordinator.
# COORDINATOR_URL=http://localhost:8080
# COORDINATOR_OPERATOR_TOKEN=

# --- flashml-web (these reach the browser; publishable values only) --------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>

# Wired by render.yaml from the API service host. The name matters:
# `cloudApiBase()` reads NEXT_PUBLIC_CLOUD_API and nothing else.
# NEXT_PUBLIC_CLOUD_API=
