# FlashML Cloud — template for the DEVELOPMENT environment. Copy to
# `.env.dev` and fill in. `.env.dev` is gitignored; this file must never
# contain a real value — no project refs, no hostnames, no keys.
#
#   ./scripts/dev.sh --all                  # uses .env.dev by default
#   ./scripts/dev.sh --all --host 0.0.0.0   # let a second machine join by LAN
#
# Production values live in `.env.prod` (template: `.env.example`). dev.sh
# refuses to start against the production project unless you pass
# --i-mean-production.
#
# Every value below comes from the Supabase dashboard for your DEV project:
#   Settings -> API      -> Project URL, publishable key
#   Settings -> Database -> password, Session pooler connection string
#
# ---------------------------------------------------------------------------
# WHERE EACH VALUE HAS TO EXIST. There are four places, and they are not
# interchangeable. A value can be correct in one and stale in another, which
# is the failure mode this map exists to prevent.
#
#   1. .env.dev / .env.prod      this repo root, gitignored, mode 600.
#                                Read by scripts/dev.sh -> the API and
#                                coordinator processes it starts.
#   2. .env.dev.example /        THIS FILE and .env.example. Tracked in git.
#      .env.example              Placeholders only, never a real value.
#   3. apps/web/.env.local       gitignored. The ONLY thing that decides
#                                which API your LOCAL console calls, and the
#                                only place NEXT_PUBLIC_* is read for
#                                `npm run dev`. Not written by dev.sh.
#   4. Render dashboard          every `sync: false` key in render.yaml —
#                                NEXT_PUBLIC_SUPABASE_URL and
#                                NEXT_PUBLIC_SUPABASE_ANON_KEY. Git cannot
#                                see these, so nothing detects drift.
#
# (1) and (4) MUST agree. On 2026-08-04 they did not: .env.dev held a valid
# publishable key while Render held a revoked one, and every sign-in on the
# deployed console failed with Supabase's "Unregistered API key". The files
# were right and the deploy was wrong, which is the hard direction to spot.
# After rotating any key in Supabase, update BOTH.
# ---------------------------------------------------------------------------

# Project URL. The API derives the JWKS endpoint from this
# (`{SUPABASE_URL}/auth/v1/.well-known/jwks.json`) and verifies every browser
# token against the public key published there. Missing => the API will not
# boot.
SUPABASE_URL=https://<dev-project-ref>.supabase.co

# Legacy HS256 only, and almost certainly blank. A project on asymmetric
# signing keys (ECC P-256) issues ES256 tokens that need no shared secret.
# Set it only to keep not-yet-expired tokens from a PREVIOUS HS256 key
# working through a rotation.
SUPABASE_JWT_SECRET=

# Settings -> Database -> Database password. Paste ONLY the password;
# DATABASE_URL below composes itself from it.
DATABASE_PASSWORD=

# Standard libpq URI. Copy the SESSION POOLER string from
# Settings -> Database and substitute the ref/region it gives you:
#
#   * SESSION pooler, port 5432 — NOT the transaction pooler on 6543.
#     psycopg uses prepared statements by default and transaction mode breaks
#     them intermittently.
#   * NOT "Direct connection": that is IPv6-only on current projects.
#   * The `postgres.<ref>` username suffix is load-bearing — the pooler routes
#     on it. Without it the server sees plain user "postgres" and refuses.
#   * Percent-encode special characters in the password
#     (@ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F).
DATABASE_URL=postgresql://postgres.<dev-project-ref>:${DATABASE_PASSWORD}@<pooler-host>.pooler.supabase.com:5432/postgres

# --- browser ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co

# ONLY the publishable/anon key ever belongs in a NEXT_PUBLIC_ var. The
# service-role key bypasses every RLS policy and owner check in db.py and must
# never appear here or in any bundle.
#
# Must MATCH the value set on flashml-dev-web in the Render dashboard — that
# one is `sync: false`, so it lives outside git and nothing compares them.
# See the drift note at the top of this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which API the console talks to. NOT read by scripts/dev.sh — Next.js reads
# NEXT_PUBLIC_* from apps/web/.env.local, so a LOCAL console takes its value
# from there, not from this file. It is recorded here so the required set is
# discoverable in one place and so the dev/prod pair is visible side by side.
#
# For a local console against this dev environment:
#     apps/web/.env.local -> NEXT_PUBLIC_CLOUD_API=https://flashml-dev-api.onrender.com
# Against a fully local backend (needs ./scripts/dev.sh for the coordinator):
#     apps/web/.env.local -> NEXT_PUBLIC_CLOUD_API=http://localhost:8000
#
# Inlined at BUILD time. Editing it and refreshing the browser changes
# nothing — restart the dev server, or the edit looks like it did not apply.
#
# Pointing a console at an API whose deploy predates the routes that console
# calls produces a 404 the UI cannot distinguish from a real "not found".
# On 2026-08-04 that surfaced as "This workspace doesn't exist, or you're not
# a member" for a workspace that existed and was owned by the caller.
NEXT_PUBLIC_CLOUD_API=https://flashml-dev-api.onrender.com
