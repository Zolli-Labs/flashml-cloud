# Local development against the DEV Supabase project (flashml-dev).
#
# Copy to `.env.dev` (gitignored) and fill in DATABASE_PASSWORD.
# Then:  ./scripts/dev.sh --all --env .env.dev
#
# WHY THIS FILE EXISTS. Until 2026-08-02 there was one `.env`, and it pointed
# DATABASE_URL at the PRODUCTION pooler. So `./scripts/dev.sh --all` read and
# wrote the same rows the deployed console serves — local development was a
# second client of production, not a separate environment.

# --- the flashml-dev Supabase project (ktstmvgasqupeuimjrog) ----------------
# NOT yualksqjjvlfscbbsygq. That one is production.
SUPABASE_URL=https://ktstmvgasqupeuimjrog.supabase.co

# Legacy HS256 only; leave blank. This project signs with ECC (P-256), so
# tokens are ES256 and verified against the JWKS derived from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Supabase -> flashml-dev -> Settings -> Database -> Database password.
# (Reset it there if you never recorded it; nothing else depends on it yet.)
DATABASE_PASSWORD=

# SESSION pooler (:5432), not the transaction pooler (:6543) — psycopg uses
# prepared statements by default and transaction mode breaks them
# intermittently. Percent-encode any special character in the password
# (@ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgresql://postgres.ktstmvgasqupeuimjrog:${DATABASE_PASSWORD}@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- browser ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ktstmvgasqupeuimjrog.supabase.co
# Publishable key. Only ever the anon/publishable key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_l9_Pp5agZR0SaEHR_MAdKQ_hqozpigJ
