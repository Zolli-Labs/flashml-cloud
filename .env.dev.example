# FlashML Cloud — template for the DEVELOPMENT environment. Copy to
# `.env.dev` and fill in. `.env.dev` is gitignored; this file must never
# contain a real value — no project refs, no hostnames, no keys.
#
#   ./scripts/dev.sh --all                  # uses .env.dev by default
#   ./scripts/dev.sh --all --host 0.0.0.0   # let a second machine join by LAN
#
# Production values live in `.env.prod` (template: `.env.example`). dev.sh
# refuses to start against the production project unless you pass
# --i-mean-production.
#
# Every value below comes from the Supabase dashboard for your DEV project:
#   Settings -> API      -> Project URL, publishable key
#   Settings -> Database -> password, Session pooler connection string

# Project URL. The API derives the JWKS endpoint from this
# (`{SUPABASE_URL}/auth/v1/.well-known/jwks.json`) and verifies every browser
# token against the public key published there. Missing => the API will not
# boot.
SUPABASE_URL=https://<dev-project-ref>.supabase.co

# Legacy HS256 only, and almost certainly blank. A project on asymmetric
# signing keys (ECC P-256) issues ES256 tokens that need no shared secret.
# Set it only to keep not-yet-expired tokens from a PREVIOUS HS256 key
# working through a rotation.
SUPABASE_JWT_SECRET=

# Settings -> Database -> Database password. Paste ONLY the password;
# DATABASE_URL below composes itself from it.
DATABASE_PASSWORD=

# Standard libpq URI. Copy the SESSION POOLER string from
# Settings -> Database and substitute the ref/region it gives you:
#
#   * SESSION pooler, port 5432 — NOT the transaction pooler on 6543.
#     psycopg uses prepared statements by default and transaction mode breaks
#     them intermittently.
#   * NOT "Direct connection": that is IPv6-only on current projects.
#   * The `postgres.<ref>` username suffix is load-bearing — the pooler routes
#     on it. Without it the server sees plain user "postgres" and refuses.
#   * Percent-encode special characters in the password
#     (@ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F).
DATABASE_URL=postgresql://postgres.<dev-project-ref>:${DATABASE_PASSWORD}@<pooler-host>.pooler.supabase.com:5432/postgres

# --- browser ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co

# ONLY the publishable/anon key ever belongs in a NEXT_PUBLIC_ var. The
# service-role key bypasses every RLS policy and owner check in db.py and must
# never appear here or in any bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
